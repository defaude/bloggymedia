{
    "name": "@defaude/bloggymedia",
    "description": "Optimize images and videos for blogging.",
    "version": "1.0.0",
    "license": "MIT",
    "type": "module",
    "bin": "dist/index.js",
    "scripts": {
        "build": "tsdown",
        "check": "tsc && biome check",
        "check-fix": "biome check --fix",
        "check-fix-unsafe": "biome check --fix --unsafe",
        "generate-fixtures": "node scripts/generate-fixtures.js",
        "test": "vitest run",
        "test-watch": "vitest"
    },
    "keywords": [
        "image",
        "video",
        "optimize"
    ],
    "author": {
        "name": "Roland Hummel",
        "email": "git@defaude.info",
        "url": "https://github.com/defaude"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@rio-cloud/biome-config": "2.0.0",
        "@tsconfig/node24": "24.0.5",
        "@types/node": "24.13.6",
        "tsdown": "0.23.0",
        "typescript": "7.0.2",
        "vitest": "5.0.1"
    },
    "dependencies": {
        "fast-glob": "3.3.3",
        "zx": "8.8.5"
    }
}
