{
    "name": "@defaude/bloggymedia",
    "description": "Optimize images and videos for blogging.",
    "version": "1.0.0",
    "license": "MIT",
    "type": "module",
    "bin": "dist/index.js",
    "scripts": {
        "build": "tsdown",
        "check": "tsc && biome check",
        "check-fix": "biome check --fix",
        "check-fix-unsafe": "biome check --fix --unsafe",
        "generate-fixtures": "node scripts/generate-fixtures.js",
        "test": "vitest run",
        "test-watch": "vitest"
    },
    "keywords": [
        "image",
        "video",
        "optimize"
    ],
    "author": {
        "name": "Roland Hummel",
        "email": "git@defaude.info",
        "url": "https://github.com/defaude"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@rio-cloud/biome-config": "1.2.0",
        "@tsconfig/node22": "22.0.6",
        "@types/node": "22.20.4",
        "tsdown": "0.16.8",
        "typescript": "5.9.3",
        "vitest": "4.1.11"
    },
    "dependencies": {
        "fast-glob": "3.3.3",
        "zx": "8.8.5"
    }
}
